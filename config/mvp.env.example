# Copy to .env.mvp and replace these four local-only examples with distinct random values.
DIAGNOSTIC_TOKEN=local-demo-diagnostic-change-me
WORKER_TOKEN=local-demo-worker-change-me
# Deterministic advisory planner; no LLM credentials required for the demo.
PLANNER_MODE=stub
# For gateway mode, configure a real provider in the Gateway state first.
GATEWAY_MODEL=worker-default
GATEWAY_API_KEY=

DIAGNOSTIC_AGENT_TOKEN=local-orchestrator-diagnostic-change-me
WORKER_AGENT_TOKEN=local-orchestrator-worker-change-me
